<Window x:Class="ExamKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ExamKiosk"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        Background="#112321"
        Foreground="#EDF4F0"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Chrome" Color="#15302D" />
        <SolidColorBrush x:Key="ChromeRaised" Color="#1C3B36" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#2D4B45" />
        <SolidColorBrush x:Key="Mint" Color="#A9DCC9" />
        <SolidColorBrush x:Key="TextMain" Color="#EDF4F0" />
        <SolidColorBrush x:Key="TextMuted" Color="#A8BBB3" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E7F1EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#294943" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#355B51" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#35594D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Background" Value="#2E755F" />
            <Setter Property="BorderBrush" Value="#2E755F" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="ExitChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Background" Value="#633F3A" />
            <Setter Property="BorderBrush" Value="#80554D" />
            <Setter Property="Foreground" Value="#FFF2EC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#7B4D44" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#98645A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#543630" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AddressField" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="#0E201E" />
            <Setter Property="Foreground" Value="#EAF2EE" />
            <Setter Property="BorderBrush" Value="#2D4B45" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#A9DCC9" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#71B99C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15302D" BorderBrush="#2A4540" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#28564A" BorderBrush="#416F60" BorderThickness="1">
                        <TextBlock Text="EK" Foreground="#C8E9DA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EXAMKIOSK" FontSize="14" FontWeight="Bold" Foreground="#EAF3EE" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="6" Height="6" Fill="#78C6A4" VerticalAlignment="Center" />
                            <TextBlock Text="SESSION ACTIVE" FontSize="9" FontWeight="SemiBold" Foreground="#AFC3BA" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" ToolTip="Back" FontSize="22" Padding="11,3" Style="{StaticResource ChromeButton}" Click="BackButton_Click" />
                    <Button Content="›" ToolTip="Forward" FontSize="22" Padding="11,3" Style="{StaticResource ChromeButton}" Click="ForwardButton_Click" />
                    <Button Content="↻" ToolTip="Reload" FontSize="18" Padding="10,6" Style="{StaticResource ChromeButton}" Click="ReloadButton_Click" />
                </StackPanel>

                <TextBox x:Name="AddressBox"
                         Grid.Column="2"
                         Style="{StaticResource AddressField}"
                         KeyDown="AddressBox_KeyDown" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ControlsButton" Content="Device controls" Style="{StaticResource PrimaryChromeButton}" Click="ControlsButton_Click" />
                    <Button Content="End session" Style="{StaticResource ExitChromeButton}" Click="QuitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0B1716">
            <wv2:WebView2 x:Name="Browser" />
        </Grid>

        <Border Grid.Row="2" Background="#15302D" BorderBrush="#2A4540" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Starting exam browser session…"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#B4C6BE" />
                <TextBlock Grid.Column="1"
                           Text="EXAMKIOSK  ·  BROWSER SESSION"
                           VerticalAlignment="Center"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#81968D" />
            </Grid>
        </Border>

        <Popup x:Name="ControlsPopup"
               PlacementTarget="{Binding ElementName=ControlsButton}"
               Placement="Bottom"
               HorizontalOffset="-258"
               VerticalOffset="8"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="ControlsPanel"
                    Width="344"
                    Padding="20"
                    Background="#173330"
                    BorderBrush="#3B5D53"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button Content="Close"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ChromeButton}"
                                Padding="9,6"
                                Click="CloseControlsButton_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Device controls" FontSize="17" FontWeight="SemiBold" Foreground="#EEF5F1" />
                            <TextBlock Text="Display, audio, and connection" FontSize="11" Foreground="#A8BBB3" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="#315047" Margin="0,0,0,16" />
                    <TextBlock Text="DISPLAY BRIGHTNESS" FontWeight="SemiBold" FontSize="10" Foreground="#B9D8CB" />
                    <Slider x:Name="BrightnessSlider"
                            Margin="0,9,0,0"
                            Minimum="0"
                            Maximum="100"
                            IsEnabled="False"
                            ValueChanged="BrightnessSlider_ValueChanged" />
                    <TextBlock x:Name="BrightnessStatusText" Text="Checking display support…" Margin="0,2,0,16" Foreground="#A8BBB3" FontSize="11" />
                    <TextBlock Text="SYSTEM VOLUME" FontWeight="SemiBold" FontSize="10" Foreground="#B9D8CB" />
                    <Slider x:Name="VolumeSlider"
                            Margin="0,9,0,0"
                            Minimum="0"
                            Maximum="100"
                            IsEnabled="False"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock x:Name="VolumeStatusText" Text="Checking audio support…" Margin="0,2,0,16" Foreground="#A8BBB3" FontSize="11" />
                    <Border Height="1" Background="#315047" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WI-FI" FontWeight="SemiBold" FontSize="10" Foreground="#B9D8CB" />
                            <TextBlock x:Name="WifiStatusText"
                                       Text="Checking connection…"
                                       Margin="0,5,0,0"
                                       Foreground="#D8E5DE"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="LOCAL TIME" FontWeight="SemiBold" FontSize="10" Foreground="#B9D8CB" HorizontalAlignment="Right" />
                            <TextBlock x:Name="TimeText"
                                       Text="--:--"
                                       Foreground="#C9E8DA"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
